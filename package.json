{
  "name": "yuquedl",
  "version": "1.0.0",
  "private": true,
  "description": "YuqueDL — 语雀知识库 Web 控制台（下载 / 任务 / 预览 / Open API / MCP）",
  "type": "module",
  "scripts": {
    "build:core": "rollup -c rollup.config.ts --configPlugin typescript",
    "build:web": "pnpm run build:core && pnpm --dir web build",
    "dev:web": "pnpm run build:core && pnpm --dir web dev --host 0.0.0.0 --port 8787",
    "start:web": "pnpm --dir web preview --host 0.0.0.0 --port 8787",
    "clean": "rm -rf dist types",
    "test:web": "pnpm --dir web test:unit",
    "test:smoke": "pnpm --dir web test:smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljw98/YuqueDL.git"
  },
  "keywords": [
    "yuque",
    "yuquedl",
    "markdown",
    "download",
    "nuxt"
  ],
  "author": "ljw98",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ljw98/YuqueDL/issues"
  },
  "homepage": "https://github.com/ljw98/YuqueDL#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.3",
    "@rollup/plugin-typescript": "^11.1.2",
    "@types/cli-progress": "^3.11.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.11.26",
    "@types/progress": "^2.0.5",
    "@types/web-bluetooth": "^0.0.20",
    "rollup": "^4.18.0",
    "tslib": "^2.6.1",
    "typescript": "^5.4.5"
  },
  "main": "dist/es/index.js",
  "types": "types/index.d.ts",
  "dependencies": {
    "axios": "^1.4.0",
    "cli-progress": "^3.12.0",
    "log4js": "^6.9.1",
    "markdown-toc": "^1.2.0",
    "mdast-util-from-markdown": "^2.0.1",
    "mdast-util-to-markdown": "^2.1.0",
    "ora": "^7.0.1",
    "pako": "1.0.11",
    "pull-md-img": "^0.0.69",
    "rand-user-agent": "1.0.109"
  },
  "engines": {
    "node": ">=18.4.0"
  }
}
